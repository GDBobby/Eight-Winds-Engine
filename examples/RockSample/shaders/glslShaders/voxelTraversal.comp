#version 450

#define MAX_STACK_DEPTH 32
#define MAX_LEVEL 8 // max depth = 8 levels = 256^3 voxels

struct OctreeNode {
    uint childMask;   // 8-bit mask: which children exist (bits 0-7)
    uint childBase;   // Index into the SSBO where the children start
    uint data;        // Application-specific payload (color, material, etc.)
    uint pad;         // Padding (to keep struct aligned to 16 bytes)
};

struct Ray {
    vec3 origin;
    vec3 dir;
};

layout(set = 0, binding = 0) readonly buffer UBO{
    mat4 projView;
    vec4 camPos;
    mat4 invProjView;
} ubo;

layout(std430, set = 1, binding = 0) readonly buffer Octree {
    OctreeNode nodes[];
};

layout(rgba8, set = 2, binding = 0) uniform writeonly image2D outImage;

struct Hit {
    bool found;
    vec3 position;
    uint data;
};

Hit traceOctree(Ray ray) {
    Hit hit;
    hit.found = false;

    // Ray in [0,1] space
    vec3 ro = ray.origin;
    vec3 rd = ray.dir;

    // Stack for node index and position
    int stack[MAX_STACK_DEPTH];
    vec3 stackPos[MAX_STACK_DEPTH];
    int stackLevel[MAX_STACK_DEPTH];
    int stackPtr = 0;

    // Start at root
    int nodeIdx = 0;
    vec3 nodeMin = vec3(0.0);
    int level = 0;

    while (true) {
        float size = 1.0 / pow(2.0, float(level));
        vec3 nodeCenter = nodeMin + vec3(size * 0.5);

        // Check ray-box intersection
        vec3 tMin = (nodeMin - ro) / rd;
        vec3 tMax = (nodeMin + size - ro) / rd;
        vec3 t1 = min(tMin, tMax);
        vec3 t2 = max(tMin, tMax);
        float tNear = max(max(t1.x, t1.y), t1.z);
        float tFar  = min(min(t2.x, t2.y), t2.z);
        if (tFar < tNear || tFar < 0.0) {
            // No intersection, pop stack
            if (stackPtr == 0) break;
            --stackPtr;
            nodeIdx = stack[stackPtr];
            nodeMin = stackPos[stackPtr];
            level = stackLevel[stackPtr];
            continue;
        }

        OctreeNode node = nodes[nodeIdx];

        if (node.childMask == 0u || level >= MAX_LEVEL) {
            // Leaf hit
            hit.found = true;
            hit.position = ro + rd * tNear;
            hit.data = node.data;
            break;
        }

        // Push siblings to stack
        for (int i = 0; i < 8; ++i) {
            if ((node.childMask & (1u << i)) == 0u) continue;

            vec3 offset = vec3(
                float(i & 1),
                float((i >> 1) & 1),
                float((i >> 2) & 1)
            );

            vec3 childMin = nodeMin + offset * size * 0.5;

            stack[stackPtr] = int(node.childBase + i);
            stackPos[stackPtr] = childMin;
            stackLevel[stackPtr] = level + 1;
            ++stackPtr;

            if (stackPtr >= MAX_STACK_DEPTH){
                break;
            }
        }

        // Pop next child
        if (stackPtr == 0){
            break;
        }
        --stackPtr;
        nodeIdx = stack[stackPtr];
        nodeMin = stackPos[stackPtr];
        level = stackLevel[stackPtr];
    }

    return hit;
}

#define GROUP_SIZE_X 8
#define GROUP_SIZE_Y 8
#define GROUP_SIZE_Z 8

layout(local_size_x = GROUP_SIZE_X, local_size_y = GROUP_SIZE_Y, local_size_z = GROUP_SIZE_Z) in;
void main() {
    // Get screen coordinates in NDC (-1 to 1)
    uvec2 pixelCoord = uvec2(
        gl_LocalInvocationID.x + gl_WorkGroupID.x * 8,
        gl_LocalInvocationID.y + gl_WorkGroupID.y * 8
    );
    vec2 uv = vec2(float(pixelCoord.x) / gl_NumWorkGroups.x, float(pixelCoord.y) / gl_NumWorkGroups.y);
    uv = (uv - 0.5) * 2.0;
    //debugPrintfEXT("num work groups - (%d)(%d)(%d)", gl_NumWorkGroups.x, gl_NumWorkGroups.y, gl_NumWorkGroups.z);

    // Generate world ray from camera
    vec4 rayStart = ubo.invProjView * vec4(uv, 0.0, 1.0);
    vec4 rayEnd   = ubo.invProjView * vec4(uv, 1.0, 1.0);
    vec3 ro = rayStart.xyz / rayStart.w;
    vec3 rd = normalize((rayEnd.xyz / rayEnd.w) - ro);

    // Build ray and trace
    Ray ray;
    ray.origin = ro;
    ray.dir = rd;

    Hit hit = traceOctree(ray);

